# --- Board-specific configuration (managed by esp_board_manager) ---
# Board: esp32_S3_DevKitC_1_breadboard
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_BOARD_ESP32_S3_DEVKITC_1_BREADBOARD=y
CONFIG_ESP_BOARD_NAME="esp32_S3_DevKitC_1_breadboard"

CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
# BMGR_CONFIG_OVERRIDE by Board sdkconfig defaults from /workspace/application/edge_agent/boards/espressif/esp32_S3_DevKitC_1_breadboard/sdkconfig.defaults.board: CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_LEDC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_RMT_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CUSTOM_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_SPI_SUPPORT=y
# --- End of board-specific configuration ---

# --- Board sdkconfig defaults ---
# Source: /workspace/application/edge_agent/boards/espressif/esp32_S3_DevKitC_1_breadboard/sdkconfig.defaults.board
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
CONFIG_USB_UVC_VIDEO_DEVICE_URB_SIZE=4096
CONFIG_APP_CLAW_LUA_MODULE_ENVIRONMENTAL_SENSOR=y
CONFIG_LUA_MODULE_ENVIRONMENTAL_SENSOR_BACKEND_BME690=n
CONFIG_LUA_MODULE_ENVIRONMENTAL_SENSOR_BACKEND_DHT=y
# --- End of Board sdkconfig defaults ---
